        "format": "<div style=\"text-align: center; padding: 12px; background-color: #1a1a24; border-radius: 8px; border: 1px solid #333;\"><h4 style=\"color: #ccc; margin-top:0; margin-bottom: 12px; font-size: 15px;\">Sinaleiro de Bancada (PickLight)</h4><div style=\"display: flex; justify-content: center; align-items: center; gap: 20px; margin-bottom: 12px;\"><div style=\"width: 38px; height: 38px; border-radius: 50%; border: 2px solid #444; background-color: {{msg.payload == 0 ? '#ff3333' : '#330000'}}; box-shadow: {{msg.payload == 0 ? '0 0 18px #ff3333' : 'none'}};\"></div><div style=\"width: 38px; height: 38px; border-radius: 50%; border: 2px solid #444; background-color: {{msg.payload == 2 ? '#ffcc00' : '#332b00'}}; box-shadow: {{msg.payload == 2 ? '0 0 18px #ffcc00' : 'none'}};\"></div><div style=\"width: 38px; height: 38px; border-radius: 50%; border: 2px solid #444; background-color: {{msg.payload == 1 ? '#00e676' : '#003311'}}; box-shadow: {{msg.payload == 1 ? '0 0 18px #00e676' : 'none'}};\"></div></div><div style=\"font-size: 15px; font-weight: bold; color: {{msg.payload == 1 ? '#00e676' : (msg.payload == 2 ? '#ffcc00' : '#ff3333')}};\">{{msg.payload == 1 ? '🟢 LINHA LIBERADA / MESA EM 0°' : (msg.payload == 2 ? '🟡 PROCESSANDO DESVIO' : '🔴 LINHA BLOQUEADA / PARADA')}}</div></div>",
